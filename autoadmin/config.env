APP_ENV=development
HTTP_ADDRESS=:9000
AGENT_GRPC_ADDRESS=:9001
CORS_ALLOWED_ORIGINS=*
SHUTDOWN_TIMEOUT=10s

# database/sql DSN. All application timestamps are read and written in UTC.
MYSQL_DSN="root:1qazXSW@@tcp(10.25.66.150:3400)/djadmin?charset=utf8mb4&parseTime=true&loc=UTC"
MYSQL_MAX_OPEN_CONNS=30
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

# Use the existing Django SECRET_KEY during route migration so both backends accept issued tokens.
JWT_SECRET="django-insecure-)u8f%(0xc-i*ft3n-kzl=(dm-_8fuyx4sq84_1=90du_jgg_m^"
JWT_EXPIRATION=24h
# Optional Fernet key. When empty, credential encryption derives the same key as Django from JWT_SECRET/SECRET_KEY.
ASSETS_CREDENTIAL_ENCRYPTION_KEY=

# golang-migrate uses URL syntax rather than the database/sql DSN above.
MIGRATION_DATABASE_URL="mysql://root:1qazXSW%40@tcp(10.25.66.150:3400)/djadmin"
MIGRATION_SOURCE_URL=file://db/migrations

RABBITMQ_URL=amqp://admin:admin123@10.25.66.150:5672//
WORKER_NAME=autoadmin-worker
WORKER_PREFETCH=4
