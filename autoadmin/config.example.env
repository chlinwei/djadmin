APP_ENV=development
HTTP_ADDRESS=:9000
AGENT_GRPC_ADDRESS=:9001
CORS_ALLOWED_ORIGINS=*
SHUTDOWN_TIMEOUT=10s

# database/sql DSN. All application timestamps are read and written in UTC.
MYSQL_DSN=autoadmin:autoadmin@tcp(127.0.0.1:3306)/djadmin?charset=utf8mb4&parseTime=true&loc=UTC
MYSQL_MAX_OPEN_CONNS=30
MYSQL_MAX_IDLE_CONNS=10
MYSQL_CONN_MAX_LIFETIME=30m

# Use the existing Django SECRET_KEY during route migration so both backends accept issued tokens.
JWT_SECRET=replace-with-a-secret-managed-outside-git
JWT_EXPIRATION=24h
# Optional Fernet key. When empty, credential encryption derives the same key as Django from JWT_SECRET/SECRET_KEY.
ASSETS_CREDENTIAL_ENCRYPTION_KEY=

# golang-migrate uses URL syntax rather than the database/sql DSN above.
MIGRATION_DATABASE_URL=mysql://autoadmin:autoadmin@tcp(127.0.0.1:3306)/djadmin
MIGRATION_SOURCE_URL=file://db/migrations/mysql
# -tags postgres 的变体：URL scheme 必须是 pgx5（golang-migrate 按 scheme 分派驱动），
# 源目录换成 postgres 侧（版本号与 mysql 侧一一对应）。
# MIGRATION_DATABASE_URL=pgx5://autoadmin:autoadmin@127.0.0.1:5432/djadmin?sslmode=disable
# MIGRATION_SOURCE_URL=file://db/migrations/postgres

# 仅 -tags postgres 的构建使用；sslmode 与 TimeZone 按部署环境调整。
POSTGRES_DSN=postgres://autoadmin:autoadmin@127.0.0.1:5432/djadmin?sslmode=disable&TimeZone=UTC

RABBITMQ_URL=amqp://autoadmin:autoadmin@127.0.0.1:5672/autoadmin
WORKER_NAME=autoadmin-worker
WORKER_PREFETCH=4

# 日志采集批量动作（下发配置 / 安装重试）的执行规模。批量动作由 **api 角色**消费采集队列后执行
# （要经 agent gRPC 会话下发命令，会话只存在于 api 进程里），因此下面四个值在 api 角色上生效：
#   *_CONCURRENCY 是单个作业内的并发上限，安装与下发分开配置（下发会重启 Filebeat，必须小）；
#   PREFETCH 是同时在跑的批量作业数（未确认消息上限）；
#   BUDGET 是单条消息的时间预算，必须明显小于 RabbitMQ 的 consumer_timeout（默认 30m）。
LOG_BATCH_INSTALL_CONCURRENCY=20
LOG_BATCH_APPLY_CONCURRENCY=5
LOG_BATCH_PREFETCH=2
LOG_BATCH_BUDGET=15m
